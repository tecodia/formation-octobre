{
  "name": "graphql-formation-fullstack",
  "version": "1.0.0",
  "description": "Formation GraphQL - Full Stack Application (Step 9)",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "prisma:generate": "cd backend && npm run prisma:generate",
    "prisma:migrate": "cd backend && npm run prisma:migrate",
    "prisma:seed": "cd backend && npm run prisma:seed",
    "prisma:studio": "cd backend && npm run prisma:studio",
    "db:setup": "cd backend && npm run db:setup"
  },
  "keywords": ["graphql", "apollo", "react", "typescript", "prisma", "postgresql"],
  "author": "Jonathan Jalouzot",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
