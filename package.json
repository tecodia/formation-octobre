  "license": "ISC",
  "description": "Formation GraphQL avec Apollo Server",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@prisma/client": "^6.16.3",
    "@types/node": "^24.6.2",
    "graphql": "^16.11.0",
    "prisma": "^6.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
