{
  "name": "graphql-formation",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "compile": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:prisma": "tsx watch src/index.prisma.ts",
    "start": "npm run compile && node ./dist/index.js",
    "start:prisma": "tsx src/index.prisma.ts",
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "Jonathan Jalouzot",
  "license": "ISC",
  "description": "Formation GraphQL avec Apollo Server",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@apollo/server-plugin-response-cache": "^5.0.0",
    "@apollo/utils.keyvadapter": "^4.0.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^10.0.25",
    "@prisma/client": "^6.16.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.2",
    "@types/ws": "^8.18.1",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "5.16.0",
    "ioredis": "^5.8.0",
    "prisma": "^6.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "ws": "^8.18.3"
  }
}
